# Sukami Configuration Template
PORT=8080

# Primary Upstream Provider (Default: Groq OpenAI-compatible endpoint)
UPSTREAM_URL=https://api.groq.com/openai

# API Credentials (Supply at least one upstream key)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional Supabase Auth Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
