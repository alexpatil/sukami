# -----------------------------------------------------------------------------
# Sukami AI Gateway Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# Network Port to listen on (Default: 8080)
PORT=8080

# Default Upstream Completions URL (Default: https://api.openai.com/v1)
UPSTREAM_URL=https://api.openai.com/v1

# Cloud Security Mode (Optional: leave empty for frictionless local development)
# When set, all incoming requests require this master key or a valid tenant key.
# Unauthenticated callers are rejected before cache access (Zero Cache Leak).
# SUKAMI_API_KEY=your-secure-master-gateway-key

# Upstream Provider Keys (Optional: clients can also supply keys per-request via headers)
# OPENAI_API_KEY=sk-proj-...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Feature Flags (Optional)
# ENABLE_SMART_ROUTING=true
# ENABLE_OUTPUT_DENSITY=false
